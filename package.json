{
  "name": "pos-mern",
  "version": "1.0.0",
  "description": "pos mern app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\" ",
    "seed": "node seeder.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:seed": "docker compose run --rm app node seeder.js"
  },
  "author": "techinfoyt",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.0",
    "colors": "^1.4.0",
    "concurrently": "^7.1.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.0.0",
    "express": "^4.18.1",
    "mongoose": "^6.3.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
