# Restaurant POS — Docker Hub image + Mongo
#
# Copy this file to the restaurant machine, then:
#   docker compose pull
#   docker compose up -d
#   docker compose run --rm app node seeder.js   # first install only

APP_PORT=8081
JWT_SECRET=change-me-to-a-long-random-string
DOCKER_IMAGE=antonalmishev/restaurant-pos:latest

# Hotel PMS — leave both empty when this install is restaurant-only.
# HOTEL_PMS_URL=http://host.docker.internal:8085
# HOTEL_PMS_API_KEY=hotel-restaurant-dev-key

# Fiscal device via ErpNet.FP. A sale stops if the printer does not answer.
FISCAL_FP_BASE_URL=http://host.docker.internal:8001
FISCAL_PRINTER_ID=
FISCAL_OPERATOR=1
FISCAL_OPERATOR_PASSWORD=1
FISCAL_TAX_GROUP=2
FISCAL_TIMEOUT_MS=30000
