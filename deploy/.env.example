# Restaurant POS — Docker Hub image + Mongo
#
# Copy this file to the restaurant machine, then:
#   docker compose pull
#   docker compose up -d
#   docker compose run --rm app node seeder.js   # first install only

APP_PORT=8081
JWT_SECRET=change-me-to-a-long-random-string
DOCKER_IMAGE=antonalmishev/restaurant-pos:latest

# Hotel PMS on the same machine. From Docker, the host is host.docker.internal.
HOTEL_PMS_URL=http://host.docker.internal:8085
HOTEL_PMS_API_KEY=hotel-restaurant-dev-key
