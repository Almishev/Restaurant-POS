# Local development (npm run server / npm run client)
PORT=8081
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/restaurant-pos
JWT_SECRET=change-me-in-production

# Docker Compose (root docker-compose.yml)
# MONGO_URI is set to mongodb://mongo:27017/restaurant-pos inside compose
APP_PORT=8081
DOCKER_IMAGE=antonalmishev/restaurant-pos:latest

# ErpNet.FP fiscal printer bridge
# Keep true until you have a real/configured printer in ErpNet.FP
FISCAL_TEST_MODE=true
FISCAL_FP_BASE_URL=http://localhost:8001
# Leave empty to auto-pick the first detected printer
FISCAL_PRINTER_ID=
FISCAL_OPERATOR=1
FISCAL_OPERATOR_PASSWORD=1
# Bulgarian VAT group B (20%) is typically 2
FISCAL_TAX_GROUP=2
FISCAL_TEST_DEVICE_SERIAL=TEST0001
FISCAL_TIMEOUT_MS=30000
